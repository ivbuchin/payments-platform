# Пример для локального запуска без Docker (сервисы читают переменные окружения напрямую).
# Инфраструктура: pnpm infra:up

# wallet-service
PORT=3001
DATABASE_URL=postgres://pp:pp@localhost:5432/wallet
AMQP_URL=amqp://guest:guest@localhost:5672

# payments-service
# PORT=3002
# DATABASE_URL=postgres://pp:pp@localhost:5432/payments
# WALLET_URL=http://localhost:3001
# WALLET_KEY_SECRET=сгенерируйте-случайную-строку-от-16-символов
# WALLET_TIMEOUT_MS=3000

# notifications-service
# PORT=3003
# DATABASE_URL=postgres://pp:pp@localhost:5432/notifications
# ALLOW_PRIVATE_WEBHOOK_TARGETS=true   # только для разработки
# DELIVERY_MAX_ATTEMPTS=8
